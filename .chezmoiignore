# Work machines keep a locally managed Git config with private identity and
# environment-specific settings. Never replace it from this repository.
{{- if eq .machine "work" }}
.gitconfig
{{- end }}

# Neovim
**/lazy-lock.json
**/lazyvim.json
.config/nvim/**/*.png
.config/nvim/**/*.jpg
.config/nvim/**/*.jpeg
**/test.*

# Zsh
**/dot_zcompdump*
**/.zcompdump*
**/*.zwc
**/private_dot_zhistory
**/private_dot_zsh_history
.config/zsh/local.zsh

# Zim framework (let it install itself)
**/dot_zim/

# Build artifacts
**/*.o
**/*.so
**/*.a

# IDE
**/.idea/
**/.vscode/

# Graphical apps — deployed only when gui = true (prompted by `chezmoi init`,
# see .chezmoi.toml.tmpl). The wallpaper png inside .config/sway is a normal
# managed file — the Neovim png patterns above are scoped to nvim on purpose.
{{- $g := printf "%v" .gui | lower | trim -}}
{{- if not (or (eq $g "true") (eq $g "yes") (eq $g "y") (eq $g "1") (eq $g "t")) }}
.config/sway/
.config/wezterm/
.config/ghostty/
.config/rofi/
.config/gtk-3.0/
.config/waybar/
.local/share/icons/
{{- end }}

# OS-specific
**/.DS_Store
**/Thumbs.db

# Pi coding agent — secrets (never track API keys)
**/auth.json

# Pi coding agent — sessions are dynamic data tied to working dirs
**/sessions/

# Pi coding agent — local/generated state under ~/.config/pi/agent, not source-of-truth config
# Skills live in ~/.agents/skills/ (synced from dot_agents/skills/). Pi's native
# config dir ~/.pi/agent/skills/ is symlinked to it by dot_config/scripts/run_once_symlink_pi_skills.sh.
.config/pi/agent/bin/
