{{- $machine := "" -}}
{{- if hasKey . "machine" -}}
{{-   $machine = .machine -}}
{{- else -}}
{{-   $machine = promptStringOnce . "machine" "machine type (personal/work)" -}}
{{- end -}}

{{- $theme := "" -}}
{{- if hasKey . "theme" -}}
{{-   $theme = .theme -}}
{{- else -}}
{{-   $theme = promptStringOnce . "theme" "theme (dark/light)" "dark" -}}
{{- end -}}

{{- $gui := false -}}
{{- if hasKey . "gui" -}}
{{-   $g := printf "%v" .gui | lower | trim -}}
{{-   if or (eq $g "true") (eq $g "yes") (eq $g "y") (eq $g "1") (eq $g "t") -}}
{{-     $gui = true -}}
{{-   else if not (or (eq $g "false") (eq $g "no") (eq $g "n") (eq $g "0") (eq $g "f")) -}}
{{-     fail (printf "gui: %q is not a boolean; chezmoi.toml [data] gui must be one of y/yes/true/1/t or n/no/false/0/f" $g) -}}
{{-   end -}}
{{- else -}}
{{-   $gui = eq "y" (promptChoiceOnce . "gui" "setup desktop environment for this machine? (deploys sway session, terminals, rofi, gtk, waybar + wallpaper)" (list "y" "n") "y") -}}
{{- end -}}

{{- $kbd := "" -}}
{{- if hasKey . "kbd" -}}
{{-   $kbd = .kbd -}}
{{- else -}}
{{-   $detected := output "sh" "-c" "localectl status 2>/dev/null | sed -n 's/^ *X11 Layout: *//p' | tr -d '\\n'" -}}
{{-   $kbd = promptStringOnce . "kbd" (printf "keyboard layout — XKB code(s), comma-separated (full list: localectl list-x11-keymap-layouts; detected: %s)" ($detected | default "unknown")) ($detected | default "it") -}}
{{- end -}}

[chezmoi]
editor = "nvim"

[diff]
command = "nvim"
args = ["-d"]

[data]
machine = {{ $machine | quote }}
theme = {{ $theme | quote }}
gui = {{ $gui }}
kbd = {{ $kbd | quote }}
