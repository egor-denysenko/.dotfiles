{{- $machine := "" -}}
{{- if hasKey . "machine" -}}
{{-   $machine = .machine -}}
{{- else -}}
{{-   $machine = promptStringOnce . "machine" "machine type (personal/work)" -}}
{{- end -}}

{{- $theme := "" -}}
{{- if hasKey . "theme" -}}
{{-   $theme = .theme -}}
{{- else -}}
{{-   $theme = promptStringOnce . "theme" "theme (dark/light)" "dark" -}}
{{- end -}}

{{- $kbd := "" -}}
{{- if hasKey . "kbd" -}}
{{-   $kbd = .kbd -}}
{{- else -}}
{{-   $detected := output "sh" "-c" "localectl status 2>/dev/null | sed -n 's/^ *X11 Layout: *//p' | tr -d '\\n'" -}}
{{-   $kbd = promptStringOnce . "kbd" (printf "keyboard layout — XKB code(s), comma-separated (full list: localectl list-x11-keymap-layouts; detected: %s)" ($detected | default "unknown")) ($detected | default "us") -}}
{{- end -}}

{{- $kbdUsb := "" -}}
{{- if hasKey . "kbd_usb" -}}
{{-   $kbdUsb = .kbd_usb -}}
{{- else -}}
{{-   $kbdUsb = promptStringOnce . "kbd_usb" "override layout for ONE external keyboard, as IDENTIFIER=LAYOUT (swaymsg -t get_inputs to find the identifier; blank to skip)" "" -}}
{{- end -}}

[data]
machine = {{ $machine | quote }}
theme = {{ $theme | quote }}
kbd = {{ $kbd | quote }}
{{ if $kbdUsb }}kbd_usb = {{ $kbdUsb | quote }}
{{ end -}}
