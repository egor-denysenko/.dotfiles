# Enable only on opted-in machines: [data] dji_dictation = true in chezmoi.toml.
{{ if get . "dji_dictation" | default false -}}
# Known receiver variants; keep ordinary keyboards and volume keys untouched.
{{ range $product := list 16661 16405 -}}
input "11427:{{ $product }}:DJI_Technology_Co.,_Ltd._Wireless_Mic_Rx_Consumer_Control" {
    xkb_file "{{ $.chezmoi.homeDir }}/.config/sway/keybinds/dji-dictation.xkb"
}
# Single click immediately toggles recording; no Enter/submission gesture.
# Deliberately unavailable while the screen is locked.
bindsym --no-repeat --input-device=11427:{{ $product }}:DJI_Technology_Co.,_Ltd._Wireless_Mic_Rx_Consumer_Control F20 exec "{{ $.chezmoi.homeDir }}/.local/bin/dji-dictation"
{{ end -}}
{{ end -}}
