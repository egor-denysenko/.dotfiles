# Warm Burnout -- Ghostty config
# Ghostty ships the upstream Warm Burnout themes, so reference them by name.
# Do NOT vendor copies in ~/.config/ghostty/themes: Ghostty matches theme names
# case-insensitively, so a local "warm-burnout-dark" collides with the built-in
# "Warm Burnout Dark" and both show up in `ghostty +list-themes`.

theme = dark:Warm Burnout Dark,light:Warm Burnout Light

# The system reports "light" here (no desktop portal on bare sway), so the
# light variant would win by default. Pin it to dark.
window-theme = dark

# Departure Mono is a pixel font: crisp only at multiples of 11px, so 13
# looked smeared. The Nerd Font patch also carries the icon glyphs used by
# nvim (lualine, nvim-tree, telescope) and waybar.
# JetBrains Mono stays in the list as a fallback — this repo runs on machines
# that don't have Departure Mono installed, and ghostty walks the list.
font-family = "DepartureMono Nerd Font, JetBrains Mono"
font-size = 11
bold-color = bright

cursor-style = block
adjust-underline-thickness = 2

window-padding-x = 10
window-padding-y = 10

window-show-tab-bar = never

background-opacity = 1.0

# Open detected URLs with Command-click in the default browser.
link-url = true

keybind = "ctrl+shift+plus=increase_font_size:1"
keybind = "ctrl+shift+minus=decrease_font_size:1"
keybind = "ctrl+shift+0=reset_font_size"
