# --- Core Environment ---
zmodule environment    # Sane Zsh defaults (history size, options)
zmodule input          # Handles backspace, delete, and home/end keys correctly
zmodule utility        # Colorizes ls/grep and adds 'mkcd', etc.

# --- Development & Tools ---
zmodule git            # Handful of shorthand aliases (gst, gco, etc.)
zmodule git-info       # Pulls git status data for your prompt
zmodule archive        # Extract any file type with one command: 'extract <file>'
zmodule duration-info  # Measures how long a command took (e.g., '3s')

# --- Prompt ---
