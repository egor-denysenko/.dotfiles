# --- Completion System ---
zmodule zsh-users/zsh-completions --fpath src  # Extra completion definitions
zmodule completion                             # Zim's smart completion engine (calls compinit)
zmodule Aloxaf/fzf-tab                         # REPLACES the clunky tab menu with fzf!
zmodule djui/alias-tips                        # Nudges into using aliases

# --- Plugins  ---
zmodule zsh-users/zsh-autosuggestions          # Suggests commands based on history (ghost text)
zmodule zdharma-continuum/fast-syntax-highlighting # Highlighting (Superior to zsh-users version)
zmodule zsh-users/zsh-history-substring-search # Type 'git', hit 'Up' to find only git commands
