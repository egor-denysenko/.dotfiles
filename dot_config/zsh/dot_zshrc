# -----------------
# 1. Environment & Path (Set early)
# -----------------
# Ensure completions and local binaries are in the path
fpath=($HOME/.config/zsh/completions $fpath)

# -----------------
# 2. History & Input Options
# -----------------
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY        # Share history between different sessions

# Wordchars: Treat / as a separator (useful for deleting path segments)
WORDCHARS=${WORDCHARS//[\/]}

# Keybindings (Emacs mode)
bindkey -e

# Try the vim one o.0
# bindkey -v 

# -----------------
# 3. Third-Party Tool Init
# -----------------
# Initialize aliases
[[ -f $ZDOTDIR/aliases.zsh ]] && source $ZDOTDIR/aliases.zsh

# Initialize fzf (Automated via Chezmoi template)
[[ -f ~/.config/zsh/completions/fzf.zsh ]] && source ~/.config/zsh/completions/fzf.zsh

# -----------------
# 4. Zim Module Configuration
# -----------------
# zsh-autosuggestions: Manual rebind for speed
ZSH_AUTOSUGGEST_MANUAL_REBIND=1

# zsh-syntax-highlighting (Only needed if NOT using fast-syntax-highlighting)
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# -----------------
# Prompt Config (Asciiship/Spaceship)
# -----------------
# Show Go version if go.mod is present
zstyle ':zim:asciiship' show-golang yes

# Define what sections appear in your prompt
SPACESHIP_PROMPT_ORDER=(
  time          # Time stamps (optional)
  user          # Username
  dir           # Current directory
  host          # Hostname
  git           # Git status
  golang        # <--- Added this
  python        # <--- Added this
  node          # <--- Added this
  exec_time     # <--- This is your (11). Remove this line to hide it.
  line_sep      # Line break
  jobs          # Background jobs indicator
  exit_code     # Exit code of last command
  char          # The prompt character (e.g., %)
)

# -----------------
# 5. Zim Framework Initialization
# -----------------
ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim

# Bootstrap zimfw if missing
if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  curl -fsSL --create-dirs -o ${ZIM_HOME}/zimfw.zsh \
      https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
fi

# Update/Install modules if .zimrc changed
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE:-${ZDOTDIR:-${HOME}}/.zimrc} ]]; then
  source ${ZIM_HOME}/zimfw.zsh init
fi

# Load the initialized modules
source ${ZIM_HOME}/init.zsh

# Add this to the end of .zshrc
if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi
