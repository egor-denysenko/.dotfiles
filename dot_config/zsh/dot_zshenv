export ZDOTDIR=$HOME/.config/zsh
export EDITOR="nvim"

export SHELL="/bin/zsh"

export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

if [[ -t 1 ]]; then
  export GPG_TTY=$(tty)
fi

export PI_HOME=$HOME/.config/pi
export PI_CODING_AGENT_DIR=$PI_HOME/agent
export PI_TELEMETRY=0
export PI_SKIP_VERSION_CHECK=1
export PI_OFFLINE=1
export PI_VCC_CONFIG_PATH=$PI_CODING_AGENT_DIR/pi-vcc-config.json

export GOPATH=$HOME/go
export GOPROXY="https://proxy.golang.org/"

# Sane, deduplicated PATH construction
typeset -U path
path=(
  $HOME/.local/bin
  $HOME/.opencode/bin
  $HOME/.bun/bin
  $GOPATH/bin
  /usr/local/go/bin
  $path
)
# Clear the removed Node manager's inherited environment when restarting a shell.
path=(${path:#$HOME/.local/share/fnm(|/*)})
path=(${path:#*/fnm_multishells/*})
unset -m 'FNM_*'
export PATH

# Vite+ owns Node and package-manager selection in every zsh session.
if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/vite-plus/env" ]]; then
  . "${XDG_CONFIG_HOME:-$HOME/.config}/vite-plus/env"
fi
