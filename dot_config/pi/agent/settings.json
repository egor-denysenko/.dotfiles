{
  "enableInstallTelemetry": false,
  "defaultProvider": "nvidia-nim",
  "defaultModel": "moonshotai/kimi-k2.6",
  "defaultThinkingLevel": "minimal",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "theme": "warm-burnout-dark",
  "shellCommandPrefix": "shopt -s expand_aliases\n[ -f ~/.config/zsh/aliases.zsh ] && source ~/.config/zsh/aliases.zsh",
  "enabledModels": [
    "deepseek-v4-flash",
    "deepseek-v4-pro",
    "glm-5.1",
    "kimi-k2.6",
    "mimo-v2.5",
    "minimax-m2.7",
    "qwen3.6-plus"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 60000
    }
  },
  "packages": [
    "git:github.com/xRyul/pi-nvidia-nim"
  ],
  "lastChangelogVersion": "0.78.1"
}
