{{- $machine := .machine | default "" -}}
{{- $emptyProfile := dict
-}}
{{- $profile := $emptyProfile -}}
{{- $profiles := .pi_agent.machine_profiles -}}
{{- if hasKey $profiles $machine -}}
{{- $profile = index $profiles $machine -}}
{{- end -}}
{
  "npmCommand": ["pnpm", "--config.shamefully-hoist=true"],
  "enableInstallTelemetry": false,
  "defaultThinkingLevel": "low",
  "quietStartup": true,
  "hideThinkingBlock": false,
  "theme": "warm-burnout-dark",
  "shellCommandPrefix": "shopt -s expand_aliases\n[ -f ~/.config/zsh/aliases.zsh ] && source ~/.config/zsh/aliases.zsh",
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 1500,
    "maxAgentDelayMs": 30000
  },
  "packages": {{ index $profile "packages" | toPrettyJson | indent 2 | trim }},
  "subagents": {},
  {{ if get $profile "device_id" }}"deviceId": {{ get $profile "device_id" | quote }},{{ end }}
  "defaultProvider": {{ get . "pi_private_default_provider" | default "openai" | quote }},
  "defaultModel": {{ get . "pi_private_default_model" | default "gpt-6.1-sol" | quote }},
  "compaction": {
    "enabled": true,
    }
  },
  "lastChangelogVersion": "1.3.0"
}
